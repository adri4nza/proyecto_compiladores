package ve.edu.unet;

import java_cup.runtime.*;
import ve.edu.unet.nodosAST.*;
import java.io.InputStreamReader;


parser code {:

/***********
SymbolFactory es una caracteristica anadida en la version 11a de cup, que facilita
la implementacion de clases Symbol personalizadas, ya que la clase Symbol por si sola
no provee mucha informacion de contexto que podria ser util para el analisis semantico
o para la construccion del AST.
Aqui se usa DefaultSymbolFactory porque es la unica implementacion que ofrece los
overloads newSymbol(nombre, id, int left, int right [, valor]), con los que el lexer
hace viajar el numero de linea dentro de cada token.
***********/

	/* ------------------------------------------------------------------
	 * Reporte de errores sintacticos (Contrato B del equipo)
	 * ------------------------------------------------------------------ */

	/* Construye "Se esperaba SEMI" a partir de los tokens que CUP esperaba */
	private String tokensEsperados() {
		StringBuilder sb = new StringBuilder();
		java.util.List<Integer> ids = expected_token_ids();
		for (int i = 0; i < ids.size() && i < 4; i++) {
			if (i > 0) sb.append(" o ");
			sb.append(sym.terminalNames[ids.get(i).intValue()]);
		}
		return sb.toString();
	}

	private String nombreToken(java_cup.runtime.Symbol s) {
		if (s == null || s.sym < 0 || s.sym >= sym.terminalNames.length) return "desconocido";
		return sym.terminalNames[s.sym];
	}

	public void syntax_error(java_cup.runtime.Symbol cur_token) {
		String esperados = tokensEsperados();
		String msg = esperados.isEmpty()
			? "Token inesperado: " + nombreToken(cur_token)
			: "Se esperaba " + esperados + ", se encontro " + nombreToken(cur_token);
		Errores.sintactico(cur_token.left, msg);
	}

	public void unrecovered_syntax_error(java_cup.runtime.Symbol cur_token) {
		Errores.sintactico(cur_token.left,
			"Error sintactico irrecuperable en: " + nombreToken(cur_token));
		/* No relanzar: se sale ordenadamente para que el IDE lea el JSON */
	}

	/* ------------------------------------------------------------------
	 * Punto de entrada del compilador
	 *
	 * DISCIPLINA DE SALIDA (Contratos B y D):
	 *   stdout -> SOLO el codigo objeto .tm
	 *   stderr -> errores en JSON (una linea por error) y, con -debug,
	 *             los volcados de AST y tabla de simbolos.
	 * Codigos de salida: 0 = compilo bien; 1 = hubo errores.
	 * ------------------------------------------------------------------ */
	public static void main(String args[]) throws Exception {
		String archivo = null;
		boolean debug = false;
		for (int i = 0; i < args.length; i++) {
			if (args[i].equals("-debug")) debug = true;
			else archivo = args[i];
		}

		DefaultSymbolFactory sf = new DefaultSymbolFactory();
		parser parser_obj;
		if (archivo == null)
			parser_obj = new parser(new Lexico(new InputStreamReader(System.in), sf), sf);
		else
			parser_obj = new parser(new Lexico(
				new InputStreamReader(new java.io.FileInputStream(archivo)), sf), sf);

		parser_obj.parse();
		NodoBase root = parser_obj.action_obj.getASTroot();

		/* 1. Si el frontend ya fallo, no tiene sentido seguir */
		if (Errores.hayErroresPrevios() || root == null) {
			System.exit(1);
		}

		if (debug) Util.imprimirAST(root);     /* sale por stderr */

		/* 2. Analisis semantico */
		TablaSimbolos ts = new TablaSimbolos();
		new AnalizadorSemantico(ts).analizar(root);
		if (debug) ts.ImprimirClaves();        /* sale por stderr */

		if (Errores.hayErrores()) {
			System.exit(1);                    /* no se genera codigo con errores */
		}

		/* 3. Generacion de codigo: unico productor de stdout */
		Generador.setTablaSimbolos(ts);
		Generador.generarCodigoObjeto(root);
		System.exit(0);
	}

:}

action code {:
	private boolean debug=false;
	private NodoBase ast=null;

	//Debe ser llamada solo despues de un parse(), en caso contrario retornara null siempre;
	public NodoBase getASTroot(){
		return ast;
	}

:}

/* Simbolos Terminales */

terminal IF;
terminal THEN;
terminal ELSE;
terminal END;
terminal REPEAT;
terminal UNTIL;
terminal READ;
terminal WRITE;
terminal String ID;
terminal String NUM;
terminal ASSIGN;
terminal EQ;
terminal LT;
terminal PLUS;
terminal MINUS;
terminal TIMES;
terminal OVER;
terminal LPAREN;
terminal RPAREN;
terminal SEMI;

/* Terminales anadidos por Tiny++ */
terminal INT, BOOL, STRING, TRUE, FALSE, FUNCTION, PROCEDURE, RETURN;
terminal LBRACKET, RBRACKET, COMMA, AND, OR, NOT;
terminal String CADENA;

/* Simbolos No Terminales */
non terminal program;
non terminal NodoBase stmt_seq;
non terminal NodoBase stmt;
non terminal NodoBase if_stmt;
non terminal NodoBase repeat_stmt;
non terminal NodoBase assign_stmt;
non terminal NodoBase read_stmt;
non terminal NodoBase write_stmt;
non terminal NodoBase exp;
non terminal NodoBase simple_exp;
non terminal NodoBase term;
non terminal NodoBase factor;

/* No terminales anadidos por Tiny++ */
non terminal NodoBase decl_stmt, func_decl, proc_decl, return_stmt, call_stmt;
non terminal Tipo tipo;
non terminal java.util.List params, param_list, args, arg_list;
non terminal NodoDeclaracion param;
non terminal NodoBase exp_or, exp_and, exp_not, exp_rel;

/* SIN DECLARACIONES DE PRECEDENCIA A PROPOSITO.
 * La gramatica de expresiones esta estratificada por niveles
 * (exp_or > exp_and > exp_not > exp_rel > simple_exp > term > factor),
 * asi que la asociatividad y la precedencia quedan fijadas por la forma de
 * las producciones. Las declaraciones "precedence left PLUS/MINUS/TIMES"
 * del Tiny base eran redundantes y se eliminaron: con ellas CUP podria
 * resolver en silencio un conflicto real en vez de reportarlo. */


/* REGLAS GRAMATICALES */
program     ::= stmt_seq:s
			{: ast = s; :}
		;

stmt_seq    ::= stmt_seq:ini SEMI stmt:sent
			{: NodoBase hijoActual = ini;
			   if(hijoActual != null){
				while(hijoActual.TieneHermano()){
					hijoActual = hijoActual.getHermanoDerecha();
				}
				hijoActual.setHermanoDerecha(sent);
				RESULT = ini;
			   }else{
				RESULT = sent;
			   }
			:}
		| stmt:sent
			{: RESULT = sent; :}
		| stmt_seq:ini SEMI
			/* tolera el punto y coma final: "int x;" justo antes de "end" */
			{: RESULT = ini; :}
		;

stmt        ::= if_stmt:sif			{: RESULT = sif; :}
		| repeat_stmt:srep		{: RESULT = srep; :}
		| assign_stmt:sasi		{: RESULT = sasi; :}
		| read_stmt:slec		{: RESULT = slec; :}
		| write_stmt:sesc		{: RESULT = sesc; :}
		| decl_stmt:sdec		{: RESULT = sdec; :}
		| func_decl:sfun		{: RESULT = sfun; :}
		| proc_decl:spro		{: RESULT = spro; :}
		| return_stmt:sret		{: RESULT = sret; :}
		| call_stmt:scal		{: RESULT = scal; :}
		| error
			/* Punto de recuperacion. NO se reporta nada aqui: el error ya lo
			 * emitio syntax_error() con el token y la linea reales. Reportar
			 * de nuevo produciria dos lineas JSON para un unico error. */
			{: RESULT = null; :}
		;

/* --- Declaraciones de variables --- */
decl_stmt   ::= tipo:t ID:nombre
			{: RESULT = new NodoDeclaracion(t, nombre.toString());
			   RESULT.setLinea(tleft);
			:}
		| tipo:t ID:nombre LBRACKET NUM:tam RBRACKET
			{: int n = 0;
			   try { n = Integer.parseInt(tam); }
			   catch (NumberFormatException ex) { n = 0; }
			   RESULT = new NodoDeclaracionArreglo(t, nombre.toString(), n);
			   RESULT.setLinea(tleft);
			:}
		;

tipo        ::= INT		{: RESULT = Tipo.ENTERO;   :}
		| BOOL		{: RESULT = Tipo.BOOLEANO; :}
		| STRING	{: RESULT = Tipo.CADENA;   :}
		;

/* --- Funciones y procedimientos --- */
func_decl   ::= FUNCTION:f tipo:t ID:nombre LPAREN params:ps RPAREN stmt_seq:cuerpo END
			{: RESULT = new NodoFuncion(t, nombre.toString(), ps, cuerpo);
			   RESULT.setLinea(fleft);
			:}
		;

proc_decl   ::= PROCEDURE:p ID:nombre LPAREN params:ps RPAREN stmt_seq:cuerpo END
			{: RESULT = new NodoProcedimiento(nombre.toString(), ps, cuerpo);
			   RESULT.setLinea(pleft);
			:}
		;

params      ::= param_list:pl	{: RESULT = pl; :}
		|		{: RESULT = new java.util.ArrayList<NodoDeclaracion>(); :}
		;

param_list  ::= param:p
			{: java.util.List<NodoDeclaracion> l = new java.util.ArrayList<NodoDeclaracion>();
			   l.add(p);
			   RESULT = l;
			:}
		| param_list:pl COMMA param:p
			{: pl.add(p);
			   RESULT = pl;
			:}
		;

param       ::= tipo:t ID:nombre
			{: RESULT = new NodoDeclaracion(t, nombre.toString());
			   RESULT.setLinea(tleft);
			:}
		| tipo:t ID:nombre LBRACKET RBRACKET
			/* Parametro de tipo arreglo: "int V[]".
			 * El tamano 0 es INTENCIONAL y significa "arreglo por referencia,
			 * tamano desconocido en la declaracion del parametro". El analisis
			 * semantico lo usa para distinguir este caso de un arreglo local
			 * con tamano real (ej. "int A[10]", que si trae su tamano). */
			{: RESULT = new NodoDeclaracionArreglo(t, nombre.toString(), 0);
			   RESULT.setLinea(tleft);
			:}
		;

return_stmt ::= RETURN:r exp:ex
			{: RESULT = new NodoRetorno(ex);
			   RESULT.setLinea(rleft);
			:}
		| RETURN:r
			{: RESULT = new NodoRetorno();
			   RESULT.setLinea(rleft);
			:}
		;

call_stmt   ::= ID:nombre LPAREN args:as RPAREN
			{: RESULT = new NodoLlamada(nombre.toString(), as);
			   RESULT.setLinea(nombreleft);
			:}
		;

args        ::= arg_list:al	{: RESULT = al; :}
		|		{: RESULT = new java.util.ArrayList<NodoBase>(); :}
		;

arg_list    ::= exp:e
			{: java.util.List<NodoBase> l = new java.util.ArrayList<NodoBase>();
			   l.add(e);
			   RESULT = l;
			:}
		| arg_list:al COMMA exp:e
			{: al.add(e);
			   RESULT = al;
			:}
		;

/* --- Sentencias --- */
assign_stmt ::= ID:variable ASSIGN exp:ex
			{: if(variable != null){
				RESULT = new NodoAsignacion(variable.toString(), ex);
				RESULT.setLinea(variableleft);
			   }else{
				RESULT = null;
				Errores.sintactico(variableleft, "Asignacion sin identificador destino");
			   }
			:}
		| ID:variable LBRACKET exp:indice RBRACKET ASSIGN exp:ex
			/* Asignacion a elemento de arreglo: A[indice] := ex.
			 * El constructor de 3 argumentos guarda el indice aparte del valor;
			 * esIndexada() lo distingue de la asignacion a variable simple. */
			{: RESULT = new NodoAsignacion(variable.toString(), indice, ex);
			   RESULT.setLinea(variableleft);
			:}
		;

read_stmt   ::= READ:r ID:variable
			{: if(variable != null){
				RESULT = new NodoLeer(variable.toString());
				RESULT.setLinea(rleft);
			   }else{
				RESULT = null;
				Errores.sintactico(rleft, "Sentencia read sin identificador");
			   }
			:}
		| READ:r ID:variable LBRACKET exp:indice RBRACKET
			/* Lectura hacia un elemento de arreglo: read A[indice].
			 * El indice viaja en el nodo; esIndexada() lo distingue del
			 * "read x" sobre una variable simple. */
			{: RESULT = new NodoLeer(variable.toString(), indice);
			   RESULT.setLinea(rleft);
			:}
		;

write_stmt  ::= WRITE:w exp:ex
			{: RESULT = new NodoEscribir(ex);
			   RESULT.setLinea(wleft);
			:}
		;

if_stmt     ::= IF:i exp:ex THEN stmt_seq:pthen END
			{: RESULT = new NodoIf(ex, pthen);
			   RESULT.setLinea(ileft);
			:}
		| IF:i exp:ex THEN stmt_seq:pthen ELSE stmt_seq:pelse END
			{: RESULT = new NodoIf(ex, pthen, pelse);
			   RESULT.setLinea(ileft);
			:}
		;

repeat_stmt ::= REPEAT:r stmt_seq:cuerpo UNTIL exp:prueba
			{: RESULT = new NodoRepeat(cuerpo, prueba);
			   RESULT.setLinea(rleft);
			:}
		;

/* --- Expresiones, estratificadas por nivel de precedencia --- */
exp         ::= exp_or:e	{: RESULT = e; :}
		;

exp_or      ::= exp_or:exI OR exp_and:exD
			{: RESULT = new NodoOperacion(exI, tipoOp.o, exD);
			   RESULT.setLinea(exIleft);
			:}
		| exp_and:ex	{: RESULT = ex; :}
		;

exp_and     ::= exp_and:exI AND exp_not:exD
			{: RESULT = new NodoOperacion(exI, tipoOp.y, exD);
			   RESULT.setLinea(exIleft);
			:}
		| exp_not:ex	{: RESULT = ex; :}
		;

exp_not     ::= NOT:n exp_not:ex
			/* not es unario: el operando va en opIzquierdo y opDerecho queda null */
			{: RESULT = new NodoOperacion(ex, tipoOp.no, null);
			   RESULT.setLinea(nleft);
			:}
		| exp_rel:ex	{: RESULT = ex; :}
		;

exp_rel     ::= simple_exp:exI LT simple_exp:exD
			{: RESULT = new NodoOperacion(exI, tipoOp.menor, exD);
			   RESULT.setLinea(exIleft);
			:}
		| simple_exp:exI EQ simple_exp:exD
			{: RESULT = new NodoOperacion(exI, tipoOp.igual, exD);
			   RESULT.setLinea(exIleft);
			:}
		| simple_exp:ex	{: RESULT = ex; :}
		;

simple_exp  ::= simple_exp:exI PLUS term:exD
			{: RESULT = new NodoOperacion(exI, tipoOp.mas, exD);
			   RESULT.setLinea(exIleft);
			:}
		| simple_exp:exI MINUS term:exD
			{: RESULT = new NodoOperacion(exI, tipoOp.menos, exD);
			   RESULT.setLinea(exIleft);
			:}
		| term:ex	{: RESULT = ex; :}
		;

term        ::= term:exI TIMES factor:exD
			{: RESULT = new NodoOperacion(exI, tipoOp.por, exD);
			   RESULT.setLinea(exIleft);
			:}
		| term:exI OVER factor:exD
			{: RESULT = new NodoOperacion(exI, tipoOp.entre, exD);
			   RESULT.setLinea(exIleft);
			:}
		| factor:ex	{: RESULT = ex; :}
		;

factor      ::= LPAREN exp:ex RPAREN
			{: RESULT = ex; :}
		| NUM:valor
			{: if(valor != null){
				RESULT = new NodoValor(Integer.parseInt(valor));
				RESULT.setLinea(valorleft);
			   }else{
				RESULT = null;
				Errores.sintactico(valorleft, "Literal numerico sin valor");
			   }
			:}
		| ID:variable
			{: if(variable != null){
				RESULT = new NodoIdentificador(variable.toString());
				RESULT.setLinea(variableleft);
			   }else{
				RESULT = null;
				Errores.sintactico(variableleft, "Identificador sin lexema");
			   }
			:}
		| ID:nombre LBRACKET exp:indice RBRACKET
			{: RESULT = new NodoAccesoArreglo(nombre.toString(), indice);
			   RESULT.setLinea(nombreleft);
			:}
		| ID:nombre LPAREN args:as RPAREN
			{: RESULT = new NodoLlamada(nombre.toString(), as);
			   RESULT.setLinea(nombreleft);
			:}
		| TRUE:t
			{: RESULT = new NodoBooleano(true);
			   RESULT.setLinea(tleft);
			:}
		| FALSE:f
			{: RESULT = new NodoBooleano(false);
			   RESULT.setLinea(fleft);
			:}
		| CADENA:c
			{: RESULT = new NodoString(c);
			   RESULT.setLinea(cleft);
			:}
		| error
			/* Punto de recuperacion dentro de una expresion. Igual que en stmt,
			 * no se reporta aqui: syntax_error() ya emitio el JSON del error. */
			{: RESULT = null; :}
		;
