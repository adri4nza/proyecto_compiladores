# ── Puerto del servidor ───────────────────────────────────────────────────────
PORT=3001

# ── Ruta al proyecto Java (relativa a servidor_puente/ o absoluta) ────────────
JAVA_PROJECT_PATH=../motor_compilador/Compiladores_Tiny_Generacion_2022_1

# ── Clase principal del compilador (NO cambiar — es ve.edu.unet.parser) ───────
JAVA_MAIN_CLASS=ve.edu.unet.parser

# ── Ejecutable de Java en WSL ────────────────────────────────────────────────
# Dejar vacío para usar el del PATH. Ejemplo: /usr/lib/jvm/java-11-openjdk-amd64/bin/java
JAVA_BIN=java

# ── Timeout de compilación en ms ─────────────────────────────────────────────
COMPILE_TIMEOUT_MS=15000

# ── Binario del simulador TM (Módulo 3 — Carlos) ─────────────────────────────
# Ruta al binario compilado con gcc.
TM_BINARY_PATH=../simulador_tm/tm

# ── Activar el binario TM real (requiere que Carlos agregue el modo -s) ───────
# false  → usa el simulador mock (funciona HOY, depurador visual activo)
# true   → usa ./tm -s   (requiere la modificación de Carlos en TM.C)
USE_REAL_TM=false
